# Draft recipe; finalize the checksum before submitting to the AUR.
# Maintainer: Amir Shygun <a-shygun@users.noreply.github.com>
pkgname=terrascope
pkgver=0.2.2
pkgrel=1
pkgdesc="Braille-rendered terminal world map with live weather and aircraft"
arch=('any')
url="https://github.com/a-shygun/terrascope"
license=('MIT')
depends=('python>=3.10' 'python-numpy' 'python-pillow' 'python-pyyaml' 'python-shapefile')
makedepends=('python-build' 'python-installer' 'python-hatchling')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # Replace with the release archive checksum before submitting to the AUR.

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
