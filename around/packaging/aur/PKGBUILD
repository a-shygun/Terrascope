# Maintainer: Amir Shygun <ryan.shygun@gmail.com>
pkgname=around
pkgver=0.1.0
pkgrel=1
pkgdesc="A braille-rendered terminal world map with live flight tracking"
arch=('any')
url="https://github.com/a-shygun/around"
license=('MIT')
depends=('python' 'python-numpy' 'python-pillow')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
source=("$pkgname-$pkgver.tar.gz::https://github.com/a-shygun/around/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with `updpkgsums` once the release tarball exists

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
