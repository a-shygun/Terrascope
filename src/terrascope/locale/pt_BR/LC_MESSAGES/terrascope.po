#: src/terrascope/core/cli.py:58
msgid ""
"A Braille terminal map with live air, weather, and quake layers.\n"
"Every option below overrides the matching value in default.yaml for this run"
" only."
msgstr ""
"Um mapa de terminal em braille, com camadas ao vivo de aviões, clima e "
"sismos.\n"
"Cada opção abaixo sobrepõe o valor correspondente do default.yaml, só nesta "
"execução."

#: src/terrascope/core/cli.py:134
msgid "Startup and layers"
msgstr "Inicialização e camadas"

#: src/terrascope/core/cli.py:135
msgid "Data, network and cache"
msgstr "Dados, rede e cache"

#: src/terrascope/core/cli.py:136
msgid "Terminal and main loop"
msgstr "Terminal e laço principal"

#: src/terrascope/core/cli.py:137
msgid "Map appearance"
msgstr "Aparência do mapa"

#: src/terrascope/core/cli.py:138
msgid "Zoom and panning"
msgstr "Zoom e deslocamento"

#: src/terrascope/core/cli.py:139
msgid "Screen layout"
msgstr "Disposição da tela"

#: src/terrascope/core/cli.py:140
msgid "Place names (basemap layer)"
msgstr "Nomes de lugares (camada do mapa base)"

#: src/terrascope/core/cli.py:141
msgid "Planes and airports (PLANES tab)"
msgstr "Aviões e aeroportos (aba VOOS)"

#: src/terrascope/core/cli.py:142
msgid "Weather: cities and forecast (WEATHER tab)"
msgstr "Clima: cidades e previsão (aba CLIMA)"

#: src/terrascope/core/cli.py:143
msgid "Weather: radar / cloud overlay (WEATHER tab)"
msgstr "Clima: radar / camada de nuvens (aba CLIMA)"

#: src/terrascope/core/cli.py:144
msgid "Weather: earthquakes (WEATHER tab)"
msgstr "Clima: sismos (aba CLIMA)"

#: src/terrascope/core/cli.py:145
msgid "Day / night (TIME tab)"
msgstr "Dia / noite (aba HORA)"

#: src/terrascope/core/cli.py:146
msgid "Configuration files and raw settings"
msgstr "Arquivos de configuração e opções brutas"

#: src/terrascope/core/cli.py:147
msgid "Information (print something and exit)"
msgstr "Informações (mostram algo e encerram)"

#: src/terrascope/core/cli.py:148
msgid "Language and regional formats"
msgstr "Idioma e formatos regionais"

#: src/terrascope/core/cli.py:175
msgid "Clock format: 24 h or 12 h. The default follows the language."
msgstr "Formato do relógio: 24 h ou 12 h. O padrão segue o idioma."

#: src/terrascope/core/cli.py:177
msgid "Temperatures and speeds: metric (°C, km/h) or imperial (°F, mph)."
msgstr "Temperaturas e velocidades: métrico (°C, km/h) ou imperial (°F, mph)."

#: src/terrascope/core/cli.py:180
msgid "Show the panel at launch (the H key toggles it)."
msgstr "Mostra o painel ao iniciar (a tecla H alterna)."

#: src/terrascope/core/cli.py:183
msgid "Timeout for downloading Natural Earth map data."
msgstr "Tempo limite para baixar os dados do mapa do Natural Earth."

#: src/terrascope/core/cli.py:185
msgid "Base URL the Natural Earth GeoJSON files are downloaded from."
msgstr "URL base de onde são baixados os arquivos GeoJSON do Natural Earth."

#: src/terrascope/core/cli.py:188
msgid ""
"Redefine terminal palette slots to the exact colours (turn off if colours "
"look wrong or stay garbled after exit)."
msgstr ""
"Redefine as cores da paleta do terminal para as cores exatas (desligue se as"
" cores parecerem erradas ou ficarem embaralhadas ao sair)."

#: src/terrascope/core/cli.py:191
msgid "Upper bound on curses colour pairs (default: automatic, capped at 255)."
msgstr "Limite máximo de pares de cores do curses (padrão: automático, até 255)."

#: src/terrascope/core/cli.py:193
msgid "Below this many columns the app shows 'Terminal too small'."
msgstr "Abaixo deste número de colunas o app mostra 'Terminal pequeno demais'."

#: src/terrascope/core/cli.py:195
msgid "Below this many rows the app shows 'Terminal too small'."
msgstr "Abaixo deste número de linhas o app mostra 'Terminal pequeno demais'."

#: src/terrascope/core/cli.py:197
msgid "Main-loop sleep between passes."
msgstr "Pausa do laço principal entre as passagens."

#: src/terrascope/core/cli.py:199
msgid "Main-loop sleep while dragging the map."
msgstr "Pausa do laço principal ao arrastar o mapa."

#: src/terrascope/core/cli.py:201
msgid "Forced repaint interval when nothing changes."
msgstr "Intervalo de redesenho forçado quando nada muda."

#: src/terrascope/core/cli.py:203
msgid "Input events drained per loop pass (so held keys don't lag)."
msgstr ""
"Eventos de entrada processados por passagem (para teclas seguradas não "
"travarem)."

#: src/terrascope/core/cli.py:205
msgid "Name of the log file inside the cache directory (stderr goes there)."
msgstr "Nome do arquivo de log dentro do diretório de cache (o stderr vai para lá)."

#: src/terrascope/core/cli.py:207
msgid "Country outlines."
msgstr "Contornos dos países."

#: src/terrascope/core/cli.py:209
msgid "State / province borders (default: the country colour, dimmed)."
msgstr "Divisas estaduais e provinciais (padrão: a cor dos países, esmaecida)."

#: src/terrascope/core/cli.py:211
msgid ""
"Ocean background: #rrggbb, #rrggbbaa (aa = opacity) or 'none' for "
"transparent."
msgstr ""
"Fundo do oceano: #rrggbb, #rrggbbaa (aa = opacidade) ou 'none' para "
"transparente."

#: src/terrascope/core/cli.py:213
msgid "Land background: #rrggbb, #rrggbbaa (aa = opacity) or 'none' for transparent."
msgstr ""
"Fundo da terra: #rrggbb, #rrggbbaa (aa = opacidade) ou 'none' para "
"transparente."

#: src/terrascope/core/cli.py:215
msgid ""
"Colour partial opacity is blended against (roughly your terminal's "
"background)."
msgstr ""
"Cor contra a qual a opacidade parcial é misturada (aproximadamente o fundo "
"do seu terminal)."

#: src/terrascope/core/cli.py:217
msgid "Terminal cell height / width; try 1.8-2.2 if the map looks stretched."
msgstr ""
"Altura / largura da célula do terminal; tente 1,8 a 2,2 se o mapa parecer "
"esticado."

#: src/terrascope/core/cli.py:219
msgid "Shades between water and land (fewer = fewer colour pairs used)."
msgstr "Tons entre água e terra (menos = menos pares de cores usados)."

#: src/terrascope/core/cli.py:221
msgid "Southern edge of the visible latitude band."
msgstr "Borda sul da faixa de latitude visível."

#: src/terrascope/core/cli.py:223
msgid "Northern edge of the visible latitude band."
msgstr "Borda norte da faixa de latitude visível."

#: src/terrascope/core/cli.py:226
msgid "Fully zoomed-out level (also the starting zoom)."
msgstr "Nível de zoom mínimo (também o zoom inicial)."

#: src/terrascope/core/cli.py:227
msgid "Most zoomed-in level."
msgstr "Nível de zoom máximo."

#: src/terrascope/core/cli.py:229
msgid "Zoom multiplier per key press / wheel notch."
msgstr "Fator de zoom por tecla ou pulso da roda."

#: src/terrascope/core/cli.py:231
msgid "Fraction of the visible span moved per key press."
msgstr "Fração da área visível deslocada por tecla."

#: src/terrascope/core/cli.py:233
msgid "State / province borders appear from this zoom on."
msgstr "As divisas estaduais e provinciais aparecem a partir deste zoom."

#: src/terrascope/core/cli.py:236
msgid "Columns,rows kept free around the screen, e.g. 2,1."
msgstr "Colunas,linhas mantidas livres ao redor da tela, ex.: 2,1."

#: src/terrascope/core/cli.py:238
msgid "Horizontal panel height in rows, borders included."
msgstr "Altura do painel horizontal em linhas, bordas incluídas."

#: src/terrascope/core/cli.py:240
msgid "Panel placement: horizontal along the bottom or vertical on the left."
msgstr "Posição do painel: horizontal na parte de baixo ou vertical à esquerda."

#: src/terrascope/core/cli.py:242
msgid "Blank columns between tabs."
msgstr "Colunas em branco entre as abas."

#: src/terrascope/core/cli.py:243
msgid "Legend text on the map."
msgstr "Texto da legenda no mapa."

#: src/terrascope/core/cli.py:246
msgid "Clicking a country code toggles its full name."
msgstr "Clicar no código de um país alterna para o nome completo."

#: src/terrascope/core/cli.py:248
msgid "Country names show up to this zoom, then give way to cities."
msgstr "Os nomes dos países aparecem até este zoom e depois dão lugar às cidades."

#: src/terrascope/core/cli.py:250
msgid "National capitals show from this zoom on."
msgstr "As capitais nacionais aparecem a partir deste zoom."

#: src/terrascope/core/cli.py:252
msgid "Tabs without full detail only label cities at least this big."
msgstr "Abas sem detalhe completo só rotulam cidades com pelo menos este tamanho."

#: src/terrascope/core/cli.py:254
msgid "Blank columns required between two labels on a row."
msgstr "Colunas em branco exigidas entre dois rótulos na mesma linha."

#: src/terrascope/core/cli.py:256
msgid "Hard cap on place-name labels."
msgstr "Limite máximo de rótulos de lugares."

#: src/terrascope/core/cli.py:259
msgid "Minimum time between OpenSky requests (anonymous use is rate-limited)."
msgstr "Tempo mínimo entre requisições ao OpenSky (o uso anônimo tem limite de taxa)."

#: src/terrascope/core/cli.py:261
msgid "OpenSky request timeout."
msgstr "Tempo limite das requisições ao OpenSky."

#: src/terrascope/core/cli.py:262
msgid "OpenSky states endpoint."
msgstr "Endereço dos estados do OpenSky."

#: src/terrascope/core/cli.py:264
msgid "Positions remembered per aircraft (tail length and time-slider range)."
msgstr ""
"Posições guardadas por aeronave (comprimento da cauda e alcance do controle "
"de tempo)."

#: src/terrascope/core/cli.py:266
msgid "At this zoom or higher plane dots become heading arrows."
msgstr "A partir deste zoom, os pontos dos aviões viram setas de rumo."

#: src/terrascope/core/cli.py:268
msgid "Airport markers on the planes tab (the K key toggles them)."
msgstr "Marcadores de aeroportos na aba de voos (a tecla K alterna)."

#: src/terrascope/core/cli.py:270
msgid "IATA/ICAO codes appear from this zoom on."
msgstr "Os códigos IATA/ICAO aparecem a partir deste zoom."

#: src/terrascope/core/cli.py:272
msgid "Hard cap on airport markers."
msgstr "Limite máximo de marcadores de aeroportos."

#: src/terrascope/core/cli.py:274
msgid "Airport marker colour."
msgstr "Cor do marcador de aeroporto."

#: src/terrascope/core/cli.py:277
msgid "City labels with temperatures (the C key toggles them)."
msgstr "Rótulos das cidades com temperaturas (a tecla C alterna)."

#: src/terrascope/core/cli.py:279
msgid "How often a city's weather is refreshed."
msgstr "Com que frequência o clima de uma cidade é atualizado."

#: src/terrascope/core/cli.py:280
msgid "Open-Meteo endpoint."
msgstr "Endereço do Open-Meteo."

#: src/terrascope/core/cli.py:282
msgid "Simultaneous weather requests."
msgstr "Requisições de clima simultâneas."

#: src/terrascope/core/cli.py:284
msgid "Days after today shown in the forecast box (0-15)."
msgstr "Dias após hoje mostrados na caixa de previsão (0-15)."

#: src/terrascope/core/cli.py:286
msgid "Most cities labelled (and weather-fetched) at once."
msgstr "Número máximo de cidades rotuladas (e consultadas) de uma vez."

#: src/terrascope/core/cli.py:288
msgid "Colour of the coldest city."
msgstr "Cor da cidade mais fria."

#: src/terrascope/core/cli.py:290
msgid "Colour of the hottest city."
msgstr "Cor da cidade mais quente."

#: src/terrascope/core/cli.py:292
msgid "Rain radar / cloud overlay."
msgstr "Radar de chuva / camada de nuvens."

#: src/terrascope/core/cli.py:294
msgid "RainViewer provides radar only; satellite mode is unavailable."
msgstr "O RainViewer fornece só radar; o modo satélite não está disponível."

#: src/terrascope/core/cli.py:296
msgid "RainViewer catalog API (terrascope_RAINVIEWER_URL overrides this)."
msgstr ""
"API do catálogo do RainViewer (terrascope_RAINVIEWER_URL substitui este "
"valor)."

#: src/terrascope/core/cli.py:298
msgid "1 = full palette colours, lower = fainter."
msgstr "1 = cores completas da paleta; menor = mais fraco."

#: src/terrascope/core/cli.py:300
msgid "Loop all frames instead of holding the live frame."
msgstr "Repete todos os quadros em vez de manter o quadro atual."

#: src/terrascope/core/cli.py:302
msgid "Most observed frames kept (10 minutes apart)."
msgstr "Número máximo de quadros observados guardados (a cada 10 minutos)."

#: src/terrascope/core/cli.py:304
msgid "Legacy setting; RainViewer no longer provides forecast frames."
msgstr "Opção antiga; o RainViewer não fornece mais quadros de previsão."

#: src/terrascope/core/cli.py:306
msgid "Drop observed frames older than this (0 = keep everything offered)."
msgstr ""
"Descarta quadros observados mais antigos que isto (0 = manter tudo o que for"
" oferecido)."

#: src/terrascope/core/cli.py:308
msgid "Raster detail: each step quadruples the tile requests per frame."
msgstr "Detalhe da imagem: cada passo quadruplica os pedidos de blocos por quadro."

#: src/terrascope/core/cli.py:310
msgid "Intensity levels / colours (above ~10 colours may get mixed up)."
msgstr "Níveis e cores de intensidade (acima de ~10 cores, elas podem se confundir)."

#: src/terrascope/core/cli.py:312
msgid "Samples per half-cell per axis (1 = fastest, 3 = smoothest)."
msgstr "Amostras por meia célula em cada eixo (1 = mais rápido, 3 = mais suave)."

#: src/terrascope/core/cli.py:314
msgid "Colour the radar fades towards (roughly the map's colour)."
msgstr "Cor para a qual o radar esmaece (aproximadamente a cor do mapa)."

#: src/terrascope/core/cli.py:317
msgid "Earthquake markers (the E key toggles them)."
msgstr "Marcadores de sismos (a tecla E alterna)."

#: src/terrascope/core/cli.py:319
msgid "Events below this magnitude are hidden."
msgstr "Eventos abaixo desta magnitude ficam ocultos."

#: src/terrascope/core/cli.py:321
msgid "Minimum time between USGS requests."
msgstr "Tempo mínimo entre requisições ao USGS."

#: src/terrascope/core/cli.py:323
msgid "Quakes older than this are drawn faded."
msgstr "Sismos mais antigos que isto são desenhados esmaecidos."

#: src/terrascope/core/cli.py:324
msgid "USGS GeoJSON feed."
msgstr "Feed GeoJSON do USGS."

#: src/terrascope/core/cli.py:327
msgid "Starting look: 'tint' (coloured land background) or 'fill' (dotted fill)."
msgstr ""
"Aparência inicial: 'tint' (fundo colorido na terra) ou 'fill' (preenchimento"
" pontilhado)."

#: src/terrascope/core/cli.py:329
msgid "Opacity of the land tint (0 = none, 1 = full colour)."
msgstr "Opacidade do tom da terra (0 = nenhuma, 1 = cor total)."

#: src/terrascope/core/cli.py:331
msgid "How often the day/night bands are recalculated."
msgstr "Com que frequência as faixas de dia e noite são recalculadas."

#: src/terrascope/core/cli.py:344
msgid "on"
msgstr "ligado"

#: src/terrascope/core/cli.py:344
msgid "off"
msgstr "desligado"

#: src/terrascope/core/cli.py:350
#, python-brace-format
msgid "One of: {choices}."
msgstr "Um de: {choices}."

#: src/terrascope/core/cli.py:353 src/terrascope/core/cli.py:355
#, python-brace-format
msgid "(default: {value})"
msgstr "(padrão: {value})"

#: src/terrascope/core/cli.py:371
msgid "start on the first tab"
msgstr "inicia na primeira aba"

#: src/terrascope/core/cli.py:372
msgid "planes tab, cached data only"
msgstr "aba de voos, só dados em cache"

#: src/terrascope/core/cli.py:381
msgid "examples:"
msgstr "exemplos:"

#: src/terrascope/core/cli.py:384
msgid "tabs"
msgstr "abas"

#: src/terrascope/core/cli.py:386
msgid "precedence (later wins):"
msgstr "precedência (o último vence):"

#: src/terrascope/core/cli.py:389
msgid "notes:"
msgstr "notas:"

#: src/terrascope/core/cli.py:390
msgid ""
"Flags with a --no-X form switch a feature on or off (e.g. --airports / --no-"
"airports)."
msgstr ""
"Opções com a forma --no-X ligam ou desligam um recurso (ex.: --airports / "
"--no-airports)."

#: src/terrascope/core/cli.py:391
msgid "Colours are #rrggbb (quote them in your shell: '#rrggbb')."
msgstr "As cores são #rrggbb (coloque entre aspas no shell: '#rrggbb')."

#: src/terrascope/core/cli.py:392
msgid ""
"--set takes YAML values, so colours must be quoted inside: --set "
"'map.land_color=\"#101018\"'."
msgstr ""
"--set aceita valores YAML, então as cores devem ir entre aspas: --set "
"'map.land_color=\"#101018\"'."

#: src/terrascope/core/cli.py:393
msgid "Run --dump-config to see every setting you can change with --set."
msgstr "Use --dump-config para ver todas as opções que podem ser alteradas com --set."

#: src/terrascope/core/cli.py:395
msgid "environment variables:"
msgstr "variáveis de ambiente:"

#: src/terrascope/core/cli.py:396
msgid "same as --offline"
msgstr "igual a --offline"

#: src/terrascope/core/cli.py:397
msgid "same as --config FILE (applied first)"
msgstr "igual a --config ARQUIVO (aplicado primeiro)"

#: src/terrascope/core/cli.py:398
msgid "RainViewer catalog API (beats --radar-url)"
msgstr "API do catálogo do RainViewer (tem prioridade sobre --radar-url)"

#: src/terrascope/core/cli.py:399
msgid "cache location when --cache-dir is not given"
msgstr "local do cache quando --cache-dir não é informado"

#: src/terrascope/core/cli.py:401
msgid "in-app keys: run `terrascope --list-keys`."
msgstr "teclas no app: rode `terrascope --list-keys`."

#: src/terrascope/core/cli.py:418
msgid ""
"Interface language, e.g. en or pt_BR (default: auto: the config, then the "
"system)."
msgstr ""
"Idioma da interface, ex.: en ou pt_BR (padrão: auto, ou seja, a configuração"
" e depois o sistema)."

#: src/terrascope/core/cli.py:423
msgid "Show this help and exit."
msgstr "Mostra esta ajuda e encerra."

#: src/terrascope/core/cli.py:425
msgid "Show the version and exit."
msgstr "Mostra a versão e encerra."

#: src/terrascope/core/cli.py:427
msgid "List layers (name, on/off, toggle key) and exit."
msgstr "Lista as camadas (nome, ligada ou desligada, tecla) e encerra."

#: src/terrascope/core/cli.py:429
msgid "List tabs (number, name, layers they switch on) and exit."
msgstr "Lista as abas (número, nome, camadas que ligam) e encerra."

#: src/terrascope/core/cli.py:431
msgid "List keyboard shortcuts as currently configured and exit."
msgstr "Lista os atalhos de teclado como estão configurados e encerra."

#: src/terrascope/core/cli.py:433
msgid ""
"Show cache directory, log file, config files and online/offline state, then "
"exit."
msgstr ""
"Mostra o diretório de cache, o arquivo de log, os arquivos de configuração e"
" o estado online/offline, e encerra."

#: src/terrascope/core/cli.py:438
msgid "Tab to open at launch: a name or its number (1 = first)."
msgstr "Aba a abrir ao iniciar: um nome ou o número (1 = primeira)."

#: src/terrascope/core/cli.py:440
msgid ""
"Start with a layer disabled, whatever the tab says (repeatable; see --list-"
"layers)."
msgstr ""
"Inicia com uma camada desligada, qualquer que seja a aba (pode repetir; veja"
" --list-layers)."

#: src/terrascope/core/cli.py:445
msgid "Use cached data only and disable live API requests."
msgstr "Usa só dados em cache e desativa as requisições ao vivo."

#: src/terrascope/core/cli.py:447
msgid "Force live requests on (overrides the config file and terrascope_OFFLINE)."
msgstr ""
"Força as requisições ao vivo (sobrepõe o arquivo de configuração e "
"terrascope_OFFLINE)."

#: src/terrascope/core/cli.py:449
msgid ""
"Where caches, downloaded map data and the log file live (default: "
"$XDG_CACHE_HOME/terrascope or ~/.cache/terrascope)."
msgstr ""
"Onde ficam o cache, os dados do mapa baixados e o arquivo de log (padrão: "
"$XDG_CACHE_HOME/terrascope ou ~/.cache/terrascope)."

#: src/terrascope/core/cli.py:452
#, python-brace-format
msgid "User-Agent sent with every HTTP request (default: {value})."
msgstr "User-Agent enviado em cada requisição HTTP (padrão: {value})."

#: src/terrascope/core/cli.py:455
msgid ""
"Delete downloaded map data and flight / weather / quake caches from the "
"cache directory, then exit."
msgstr ""
"Apaga os dados do mapa baixados e os caches de voos, clima e sismos do "
"diretório de cache, e encerra."

#: src/terrascope/core/cli.py:460
msgid "YAML file merged over default.yaml; same layout (repeatable)."
msgstr ""
"Arquivo YAML mesclado sobre o default.yaml, com o mesmo formato (pode "
"repetir)."

#: src/terrascope/core/cli.py:462
msgid ""
"Set any default.yaml value by dotted path, value in YAML (repeatable), e.g. "
"--set map.zoom.step=2."
msgstr ""
"Define qualquer valor do default.yaml pelo caminho com pontos, com valor em "
"YAML (pode repetir), ex.: --set map.zoom.step=2."

#: src/terrascope/core/cli.py:465
msgid "Print the effective settings (after all overrides) as YAML and exit."
msgstr ""
"Mostra as configurações efetivas (após todas as sobrescritas) em YAML e "
"encerra."

